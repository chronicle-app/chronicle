# Chronicle's minimal extraction vocabulary. This is the canonical source.
@prefix : <https://schema.chronicle.app/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schemaorg: <https://schema.org/> .

: a owl:Ontology;
  owl:versionInfo "0.1.0" .

:Base a rdfs:Class;
  rdfs:comment "The common base for entities and actions described by a source. Each node carries an identity, expressed as @key or @id, so it can be referenced across records." .
:Entity a rdfs:Class;
  rdfs:subClassOf :Base;
  rdfs:comment "A thing described by a source, such as a person, place, document, or web page. An entity represents the thing itself; actions record what happened to or with it." .
:Action a rdfs:Class;
  rdfs:subClassOf :Base;
  rdfs:comment "An occurrence recorded by a source, such as reading an article, sending a message, or visiting a place. Its :object identifies the entity the action was carried out on." .
:Text a rdfs:Class;
  rdfs:subClassOf :DataType;
  rdfs:comment "A literal string, used for values such as names and source identifiers. Text is carried directly as a property value and has no node identity of its own." .
:URL a rdfs:Class;
  rdfs:subClassOf :Text;
  rdfs:comment "A Uniform Resource Locator expressed as an absolute URL string, such as https://example.com/article. Used for properties that locate a resource." .

:sourceId a rdf:Property;
  rdfs:comment "The identifier assigned by the source to an entity or action, such as a record ID or message ID. Represented as text and scoped to the source's own namespace; it need not be globally unique.";
  owl:maxCardinality 1;
  :domainIncludes :Base;
  :rangeIncludes :Text .
:name a rdf:Property;
  rdfs:comment "The human-readable name or title of an entity, such as a person's display name, a document title, or a place name.";
  owl:maxCardinality 1;
  :domainIncludes :Entity;
  :rangeIncludes :Text .
:url a rdf:Property;
  rdfs:comment "A URL at which the entity can be found, such as a web page's address or a link to a source record.";
  owl:maxCardinality 1;
  :domainIncludes :Entity;
  :rangeIncludes :URL .
:object a rdf:Property;
  rdfs:comment "The entity an action is carried out on, such as the article being read, the message being sent, or the place being visited. For movement, the :object identifies where the movement began.";
  owl:maxCardinality 1;
  :domainIncludes :Action;
  :rangeIncludes :Entity .

:DateTime a rdfs:Class;
  rdfs:subClassOf :DataType;
  rdfs:comment "An instant anchored in time, including a date and time of day. Represented as a JavaScript Date in extracted records; use only when the source provides enough information to identify an instant." .
:Agent a rdfs:Class;
  rdfs:subClassOf :Entity;
  rdfs:comment "An entity capable of performing an action, such as a person, organization, or software agent. An action's :agent identifies its doer when known." .
:Task a rdfs:Class;
  rdfs:subClassOf :Entity;
  rdfs:comment "A unit of work to be done, such as a to-do item. The task carries its :name and :description; actions record its planning, updates, completion, or cancellation." .
:Collection a rdfs:Class;
  rdfs:subClassOf :CreativeWork;
  rdfs:comment "A grouping of entities declared by a source, such as a list, an area of responsibility, or a section within a project. Members link to the collection through :isPartOf." .
:Project a rdfs:Class;
  rdfs:subClassOf :Collection;
  rdfs:comment "An organized undertaking that groups related work toward an outcome. Tasks and other constituent entities link to the project through :isPartOf." .
:Tag a rdfs:Class;
  rdfs:subClassOf :Entity;
  rdfs:comment "A label used by a source to categorize or describe entities. Represented as an entity with its own identity so the same tag can be referenced by multiple records." .
:PlanAction a rdfs:Class;
  rdfs:subClassOf :Action;
  rdfs:comment "The act of establishing an intention to do something, such as creating a to-do item. The :object identifies the planned work; the :timestamp records when the plan was made." .
:UpdateAction a rdfs:Class;
  rdfs:subClassOf :Action;
  rdfs:comment "A change to an existing entity, such as editing a task's title or notes. The :object identifies the entity that was changed." .
:CompleteAction a rdfs:Class;
  rdfs:subClassOf :Action;
  rdfs:comment "The completion of an activity or piece of work, such as finishing a task or a book. The :object identifies what was completed." .
:CancelAction a rdfs:Class;
  rdfs:subClassOf :Action;
  rdfs:comment "The withdrawal of a plan or intended activity, such as cancelling a task. The :object identifies what was cancelled." .
:DeleteAction a rdfs:Class;
  rdfs:subClassOf :Action;
  rdfs:comment "The removal of an entity from its source, including moving an item to the trash. The :object identifies what was removed." .
:source a rdf:Property;
  rdfs:comment "The source system that describes the entity or action, such as things-todo. Provides the source namespace in which identifiers such as :sourceId are interpreted.";
  owl:maxCardinality 1;
  :domainIncludes :Base;
  :rangeIncludes :Text .
:timestamp a rdf:Property;
  rdfs:comment "The instant when the action occurred, as reported by the source. Records occurrence time, not the time Chronicle extracted the record.";
  owl:maxCardinality 1;
  :domainIncludes :Action;
  :rangeIncludes :Date,
    :DateTime .
:agent a rdf:Property;
  rdfs:comment "The doer of the action, when identified by the source. Omit when no doer is known; an occurrence can be recorded without an agent.";
  owl:maxCardinality 1;
  :domainIncludes :Action;
  :rangeIncludes :Agent .
:sameAs a rdf:Property;
  rdfs:comment "Another reference to the same entity, expressed as an entity node or a textual identity reference such as @me. Asserts shared identity, rather than similarity or association.";
  :domainIncludes :Entity;
  :rangeIncludes :Entity, :Text .
:description a rdf:Property;
  rdfs:comment "Descriptive text supplied by the source about an entity, such as a task's notes or a project's summary.";
  owl:maxCardinality 1;
  :domainIncludes :Entity;
  :rangeIncludes :Text .
:handle a rdf:Property;
  rdfs:comment "A contextual identifier for an entity within its namespace, such as a username, channel slug, or tag label. Its meaning depends on the source or context in which it is used.";
  owl:maxCardinality 1;
  :domainIncludes :Entity;
  :rangeIncludes :Text .
:isPartOf a rdf:Property;
  rdfs:comment "An entity that this entity forms part of, such as a task's project or collection, or the page containing an excerpt. Each value identifies a containing whole.";
  :domainIncludes :Entity;
  :rangeIncludes :Entity .
:about a rdf:Property;
  rdfs:comment "An entity representing the subject matter of this entity, such as a topic or tag describing what a task concerns.";
  :domainIncludes :Entity;
  :rangeIncludes :Entity .

:Command a rdfs:Class;
  rdfs:subClassOf :Entity;
  rdfs:comment "An instruction issued to a computer, such as a shell command. Its :body carries the command text; an :ExecuteAction records an execution of it." .
:Person a rdfs:Class;
  rdfs:subClassOf :Agent;
  rdfs:comment "A human individual represented by a source, such as a message participant or computer user." .
:Realm a rdfs:Class;
  rdfs:subClassOf :Entity;
  rdfs:comment "A bounded account or computing domain, such as a workspace, computer system, or email domain. Agents belong to it through :memberOf; entities located within it use :inRealm." .
:ExecuteAction a rdfs:Class;
  rdfs:subClassOf :Action;
  rdfs:comment "The execution of a command or software resource. The :object identifies what was executed; :agent identifies the doer when known." .
:body a rdf:Property;
  rdfs:comment "The textual content of an entity, such as a shell command or message, as supplied by the source.";
  owl:maxCardinality 1;
  :domainIncludes :Entity;
  :rangeIncludes :Text .
:memberOf a rdf:Property;
  rdfs:comment "An entity the agent belongs to, such as a realm representing the computer system in which a user account exists.";
  :domainIncludes :Agent;
  :rangeIncludes :Entity .

:Message a rdfs:Class;
  rdfs:subClassOf :CreativeWork;
  rdfs:comment "A communicated item, such as a text message or chat reply. Its :body carries text, :contains links attachments, and :recipient identifies the intended receivers." .
:MessageAction a rdfs:Class;
  rdfs:subClassOf :Action;
  rdfs:comment "The sending of a message. The :object identifies the message and :agent identifies the sender when known." .
:MediaObject a rdfs:Class;
  rdfs:subClassOf :CreativeWork;
  rdfs:comment "A media artifact, such as an image, audio recording, video, or document. Its :contentPath or :url locates the content, and :mimeType describes its format." .
:ImageObject a rdfs:Class;
  rdfs:subClassOf :MediaObject;
  rdfs:comment "An image artifact, such as a photograph, screenshot, or image attachment." .
:AudioObject a rdfs:Class;
  rdfs:subClassOf :MediaObject;
  rdfs:comment "An audio artifact, such as a voice message, music file, or sound recording." .
:VideoObject a rdfs:Class;
  rdfs:subClassOf :MediaObject;
  rdfs:comment "A video artifact, such as a recorded clip or video attachment, which may include audio." .
:DocumentObject a rdfs:Class;
  rdfs:subClassOf :MediaObject;
  rdfs:comment "A document artifact, such as a PDF, text file, or document attachment." .
:recipient a rdf:Property;
  rdfs:comment "An agent the message was directed to. A message can have multiple recipients, such as the other participants in a group conversation.";
  :domainIncludes :Message;
  :rangeIncludes :Agent .
:contains a rdf:Property;
  rdfs:comment "A media artifact carried by a message, such as an attached image, voice recording, video, or document.";
  :domainIncludes :Message, :Entity;
  :rangeIncludes :MediaObject .
:contentPath a rdf:Property;
  rdfs:comment "An absolute filesystem path to the local file containing the media bytes. Describes where the extracted content is available on the source machine.";
  owl:maxCardinality 1;
  :domainIncludes :MediaObject;
  :rangeIncludes :Text .
:mimeType a rdf:Property;
  rdfs:comment "The MIME type of the media content, such as image/jpeg, audio/mp4, or application/pdf.";
  owl:maxCardinality 1;
  :domainIncludes :MediaObject;
  :rangeIncludes :Text .

:SoftwareAgent a rdfs:Class;
  rdfs:subClassOf :Agent;
  rdfs:comment "Running software acting as a participant, such as an assistant, bot, or automation. It can be the :agent of an action or the :author of a message." .
:SoftwareApplication a rdfs:Class;
  rdfs:subClassOf :CreativeWork;
  rdfs:comment "A software application or model used to perform work. An action can identify it through :instrument, using the source-provided application or model identifier." .
:Thread a rdfs:Class;
  rdfs:subClassOf :Collection;
  rdfs:comment "A conversation explicitly grouped by its source, such as an email thread or assistant chat. Messages link to it through :isPartOf; its :name can carry the conversation title." .
:instrument a rdf:Property;
  rdfs:comment "The tool, device, application, or model used to perform an action. The :agent identifies who acted; :instrument identifies what they used.";
  owl:maxCardinality 1;
  :domainIncludes :Action;
  :rangeIncludes :Entity .
:author a rdf:Property;
  rdfs:comment "An agent that authored the message content, such as a person or software assistant.";
  :domainIncludes :Message;
  :rangeIncludes :Agent .
:inRealm a rdf:Property;
  rdfs:comment "The realm in which an entity resides, such as the computer system hosting a conversation or file. Provides context for identifiers that are local to that realm.";
  owl:maxCardinality 1;
  :domainIncludes :Entity;
  :rangeIncludes :Realm .

:ConsumeAction a rdfs:Class;
  rdfs:comment "The agent took in the :object — read, watched, listened to, ate, or drank it; the subclasses name the mode. A bare ConsumeAction records consumption in progress without a known start.";
  rdfs:subClassOf :Action .

:ViewAction a rdfs:Class;
  rdfs:comment "The agent looked at the :object — a web page visited, a photo opened, a document viewed. A point encounter rather than a consumption in progress.";
  rdfs:subClassOf :ConsumeAction .

:Number a rdfs:Class;
  rdfs:comment "A numeric value, integral or decimal.";
  rdfs:subClassOf :DataType .
:startTime a rdf:Property;
  rdfs:comment "The start time of an action, or the start bound of an interval value. A :DateTime is an anchored instant; a :Date is a civil whole-day bound (e.g. an all-day event).";
  owl:maxCardinality 1;
  :domainIncludes :Action,
    :Event,
    :Interval;
  :rangeIncludes :Date,
    :DateTime .
:endTime a rdf:Property;
  rdfs:comment "The end time of an action, or the end bound of an interval value. A :DateTime is an anchored instant; a :Date is a civil whole-day bound (e.g. an all-day event).";
  owl:maxCardinality 1;
  :domainIncludes :Action,
    :Event,
    :Interval;
  :rangeIncludes :Date,
    :DateTime .
:result a rdf:Property;
  rdfs:comment "What the action produced — the artifact or session that came into being through it.";
  owl:maxCardinality 1;
  :domainIncludes :Action;
  :rangeIncludes :Entity .

:StructuredValue a rdfs:Class;
  rdfs:comment "A value made of several fields — a position, an interval — that describes something without being an identified entity of its own." .
:Location a rdfs:Class;
  rdfs:comment "A geographic position and address — coordinates (:latitude, :longitude, :elevation) and address parts (:address, :locality, :region, :country, :postalCode). A structured value with no identity of its own; the identified place it describes is a :Place.";
  rdfs:subClassOf :StructuredValue .
:Place a rdfs:Class;
  rdfs:comment "A location in the world with an identity of its own — a venue, a city, a region, a country. Its geographic position and address are its :location value.";
  rdfs:subClassOf :Entity .
:Venue a rdfs:Class;
  rdfs:comment "A specific place one goes to — a café, a shop, a park, a home, an office. The :object of a :VisitAction or :CheckInAction, and the :location where something happened.";
  rdfs:subClassOf :Place .
:location a rdf:Property;
  rdfs:comment "The location associated with the action or entity.";
  owl:maxCardinality 1;
  :domainIncludes :Action,
    :Entity,
    :Event;
  :rangeIncludes :Place, :Location .
:latitude a rdf:Property;
  rdfs:comment "The latitude of the location.";
  owl:maxCardinality 1;
  :domainIncludes :Location;
  :rangeIncludes :Number .
:longitude a rdf:Property;
  rdfs:comment "The longitude of the location.";
  owl:maxCardinality 1;
  :domainIncludes :Location;
  :rangeIncludes :Number .
:address a rdf:Property;
  rdfs:comment "The address of the location.";
  owl:maxCardinality 1;
  :domainIncludes :Location;
  :rangeIncludes :Text .
:category a rdf:Property;
  rdfs:comment "Categories or tags that classify the entity or action.";
  :domainIncludes :Entity;
  :rangeIncludes :Text .

:VisitAction a rdfs:Class;
  rdfs:comment "The agent was present at the :object place over :startTime to :endTime — a stay somewhere, as distinct from the :TravelAction between stays.";
  rdfs:subClassOf :Action .
:TravelAction a rdfs:Class;
  rdfs:comment "The agent travelled from :object to :target — a physical journey between places, over :startTime to :endTime. Its :result is the :Journey recording the route, mode, and distance.";
  rdfs:subClassOf :Action .
:Journey a rdfs:Class;
  rdfs:comment "A recorded segment of travel — the :result of a :TravelAction, carrying the :travelMode, the :distance, and the route as :path. Dateless itself; the action carries the span.";
  rdfs:subClassOf :Entity .
:travelMode a rdf:Property;
  rdfs:comment "The mode of travel of a journey (e.g. walking, cycling, driving).";
  owl:maxCardinality 1;
  :domainIncludes :Journey;
  :rangeIncludes :Text .
:distance a rdf:Property;
  rdfs:comment "The distance covered by a journey, in meters.";
  owl:maxCardinality 1;
  :domainIncludes :Journey;
  :rangeIncludes :Number .
:path a rdf:Property;
  rdfs:comment "The recorded route of a journey.";
  owl:maxCardinality 1;
  :domainIncludes :Journey;
  :rangeIncludes :Text .

:CreativeWork a rdfs:Class;
  rdfs:comment "A work made by an agent — a text, a recording, a post, a message, a document. Carries its attribution (:author, :publisher), its release (:datePublished), what it is about (:about), and its composition (:isPartOf, :contains).";
  rdfs:subClassOf :Entity .
:Channel a rdfs:Class;
  rdfs:comment "A named, multi-participant messaging container that messages are posted to — a workspace channel, a group chat, a chat room. Messages link to it with :isPartOf; a one-to-one conversation has no Channel.";
  rdfs:subClassOf :CreativeWork .
:Organization a rdfs:Class;
  rdfs:comment "A group of people acting as one — a company, an institution, a club, a school. Its :member values are the agents that belong to it.";
  rdfs:subClassOf :Agent;
  owl:equivalentClass schemaorg:Organization .
:member a rdf:Property;
  rdfs:comment "A member of the group — a musical group, an organization, or a messaging channel/group chat.";
  rdfs:subPropertyOf :involvement;
  :domainIncludes :Organization, :Channel;
  :rangeIncludes :Person, :Agent .
:inReplyTo a rdf:Property;
  rdfs:comment "The message this message is a quoted reply to.";
  rdfs:subPropertyOf :relation;
  :domainIncludes :Message;
  :rangeIncludes :Message .

:DataType a rdfs:Class;
  rdfs:comment "A simple literal value: text, a number, a date, a date-time." .
:Date a rdfs:Class;
  rdfs:comment "A civil calendar date — a day in wall-clock time with no time of day and no zone, kept as an ISO date string rather than an instant. The whole-day counterpart of :DateTime: an all-day event, a date-only life event, a bare year.";
  rdfs:subClassOf :DataType .
:Event a rdfs:Class;
  rdfs:comment "A named happening with a declared :scheduledTime — a calendar entry, a concert, a picnic. Carries its :location and :attendee values; the :object of an :AttendAction. Its actual extent derives from the activity that constitutes it.";
  rdfs:subClassOf :Entity .
:Interval a rdfs:Class;
  rdfs:comment "A bounded stretch of time — a start and an end, each at its own precision. A structured value with no identity of its own, like :Location; it carries the declared extent of an event or session (its :scheduledTime), as distinct from an action's occurrence.";
  rdfs:subClassOf :StructuredValue .
:relation a rdf:Property;
  rdfs:comment "Any edge from an entity to another entity.";
  :abstract true;
  :rangeIncludes :Entity .
:involvement a rdf:Property;
  rdfs:comment "An agent involved in an entity as addressee, attendee, or member.";
  rdfs:subPropertyOf :relation;
  :rangeIncludes :Agent .

# call-history
:InteractAction a rdfs:Class;
  rdfs:comment "An agent engages with another agent or a social object — communicating, following.";
  rdfs:subClassOf :Action .
:CommunicateAction a rdfs:Class;
  rdfs:comment "An agent conveys something to others — a message, a call, a check-in.";
  rdfs:subClassOf :InteractAction .
:CallAction a rdfs:Class;
  rdfs:comment "A phone or video call. :agent is the caller when known; the :result is the :CallSession the call constitutes, which carries the receiver as its :recipient and, for a group call, the :Channel it is :isPartOf.";
  rdfs:subClassOf :CommunicateAction .
:Session a rdfs:Class;
  rdfs:comment "A described segment of time — a bounded, characterized interval of the subject's logged activity (an app-usage block, a manual time block, a call). A sibling of :Event (a named happening); both carry a declared :scheduledTime, while their actual aliveness derives from the activity that constitutes them. A session constituted by an action (:DeviceSession, :CallSession) takes its occurrence from that action; an atomic session (a manual time block) carries its own :startTime/:endTime, like :Event.";
  rdfs:subClassOf :Entity .
:CallSession a rdfs:Class;
  rdfs:comment "A phone or FaceTime call as a described segment of time — the :result of a :CallAction. Carries the :recipient (the receiver) and, for group calls, :isPartOf a :Channel whose :member is the roster. A missed call is a zero-length span; a connected call a non-zero one.";
  rdfs:subClassOf :Session .
:notes a rdf:Property;
  rdfs:comment "Additional notes or observations.";
  owl:maxCardinality 1;
  :domainIncludes :Entity,
    :Session;
  :rangeIncludes :Text .
:recipient :domainIncludes :CallSession .
# foodnoms
:EatAction a rdfs:Class;
  rdfs:comment "The agent ate the :object, a :Meal. Where it happened is the action's :location.";
  rdfs:subClassOf :ConsumeAction .
:DrankAction a rdfs:Class;
  rdfs:comment "The agent drank the :object.";
  rdfs:subClassOf :ConsumeAction .
:Meal a rdfs:Class;
  rdfs:comment "A meal or snack the subject ate — the :object of an :EatAction. Its slot (breakfast, lunch, dinner) is :category data.";
  rdfs:subClassOf :Entity .
# twitter
:Post a rdfs:Class;
  rdfs:comment "A work published to a social or media platform — a feed post, a story, a reel, a tweet. A media-agnostic container: it may carry a text :body and :contains one or more media files (:MediaObject). Its native presentation format (feed, story, reel) is its :sourceFormat.";
  rdfs:subClassOf :CreativeWork .
:PublishAction a rdfs:Class;
  rdfs:comment "A work was published or released. Its :agent is the publisher when known and its :object the work; the work's :datePublished is when this occurred.";
  rdfs:subClassOf :CreateAction .
:CreateAction a rdfs:Class;
  rdfs:comment "The agent brought a work into existence. Its :result is the work created; the subclasses name the kind of making.";
  rdfs:subClassOf :Action .
:LikeAction a rdfs:Class;
  rdfs:comment "The agent liked the :object. Opens the agent's standing :likes run over it.";
  rdfs:subClassOf :ReactAction .
:ReactAction a rdfs:Class;
  rdfs:comment "A payload-free stance an agent takes on the :object, such as a like. A reaction that carries content (an emoji, a comment) is a :RespondAction.";
  rdfs:subClassOf :AssessAction .
:AssessAction a rdfs:Class;
  rdfs:comment "An agent takes a stance on the :object — a like, a reaction, a rating, a review.";
  rdfs:subClassOf :Action .
:references a rdf:Property;
  rdfs:comment "An entity this one references — an @mention, or a link from one resource to another (a web page's outbound link, a citation).";
  rdfs:subPropertyOf :mentions;
  :domainIncludes :CreativeWork,
    :Session,
    :Entity;
  :rangeIncludes :Entity .
:mentions a rdf:Property;
  rdfs:comment "An entity pointed to from this one (e.g. an @mention or link).";
  rdfs:subPropertyOf :relation;
  :rangeIncludes :Entity .
# facebook
:FindAction a rdfs:Class;
  rdfs:comment "The agent looked something up on a platform — an entry in a search history. :object is the :Query entered.";
  rdfs:subClassOf :Action .
:Query a rdfs:Class;
  rdfs:comment "A search query as entered. Carries the query text as :body; the :object of a :FindAction.";
  rdfs:subClassOf :CreativeWork .
:RespondAction a rdfs:Class;
  rdfs:comment "An agent responds to the :object with content — an emoji reaction, a comment, a rating, a review. The :result is the :Response carrying that content; the :object names what it is about. The payload-carrying counterpart of :LikeAction.";
  rdfs:subClassOf :AssessAction .
:Response a rdfs:Class;
  rdfs:comment "An agent's response to a thing, carrying its content in two facets: :body (an emoji reaction is a one-character body; prose is a :Comment) and :ratingValue (a review carries both). The :result of a :RespondAction, whose :object names what the response is about. The payload is kept verbatim in the source's own vocabulary, a literal ❤️ beside a platform's LOVE. A like with no payload is a :LikeAction rather than a Response.";
  rdfs:subClassOf :CreativeWork .
:Comment a rdfs:Class;
  rdfs:comment "A prose response — the :Response leaf whose :body is authored text.";
  rdfs:subClassOf :Response .
:author :domainIncludes :CreativeWork .
# instagram
:FollowAction a rdfs:Class;
  rdfs:comment "The agent began following the :object — an account, a feed, a collection. Opens the agent's :follows run over it.";
  rdfs:subClassOf :InteractAction .
:OrganizeAction a rdfs:Class;
  rdfs:comment "An agent arranges or plans things — saving, bookmarking, scheduling.";
  rdfs:subClassOf :Action .
:BookmarkAction a rdfs:Class;
  rdfs:comment "The agent saved the :object for later — a bookmarked page, an article saved to a reading list, a work shelved as to-read.";
  rdfs:subClassOf :OrganizeAction .
:sourceFormat a rdf:Property;
  rdfs:comment "The source's own presentation format for an item — which of the platform's native content shapes it is among items of the same type: a story, feed post, or reel; a video, short, or live stream; a full episode, trailer, or bonus. A descriptive, per-source, open-vocabulary label, present only where the source has such a sub-format.";
  owl:maxCardinality 1;
  :domainIncludes :CreativeWork;
  :rangeIncludes :Text .
:visibility a rdf:Property;
  rdfs:comment "How widely the work is shared: `public`, `private`, or `unlisted`, always as these lowercase tokens. A coarse bucket shared across sources, onto which each source's own audience states map.";
  owl:maxCardinality 1;
  :domainIncludes :CreativeWork;
  :rangeIncludes :Text .
# spotify
:ListenAction a rdfs:Class;
  rdfs:comment "The agent listened to the :object — a recording, a podcast episode. Opens or extends the agent's :consuming run over it.";
  rdfs:subClassOf :ConsumeAction .
:AddAction a rdfs:Class;
  rdfs:comment "The agent added the :object to the :target — a track to a playlist, a work to a collection.";
  rdfs:subClassOf :UpdateAction .
:MusicRecording a rdfs:Class;
  rdfs:comment "A recorded track — one performance of a :MusicComposition (:recordingOf) by an :artist, appearing on a :MusicAlbum via :inAlbum, with a :duration.";
  rdfs:subClassOf :CreativeWork .
:MusicAlbum a rdfs:Class;
  rdfs:comment "A released collection of recordings by an :artist; each recording on it is a :track.";
  rdfs:subClassOf :CreativeWork .
:PerformingGroup a rdfs:Class;
  rdfs:comment "An organization that performs — a band, a troupe, an ensemble.";
  rdfs:subClassOf :Organization .
:MusicGroup a rdfs:Class;
  rdfs:comment "A musical act — a band, an orchestra, or a solo artist as a performing identity. The :artist of recordings and albums.";
  rdfs:subClassOf :PerformingGroup .
:PodcastEpisode a rdfs:Class;
  rdfs:comment "One episode of a :PodcastSeries (via :series), with its :episodeNumber and :duration.";
  rdfs:subClassOf :CreativeWork .
:attribution a rdf:Property;
  rdfs:comment "An agent responsible for a creative work coming into existence.";
  rdfs:subPropertyOf :relation;
  :abstract true;
  :rangeIncludes :Agent .
:performer a rdf:Property;
  :propagatesEncounter true;
  rdfs:comment "An agent who performed or realized an existing work.";
  rdfs:subPropertyOf :attribution;
  :rangeIncludes :Agent .
:composition a rdf:Property;
  rdfs:comment "A structural part/whole relation between entities. Direction-neutral; assert :partOf or :hasPart.";
  rdfs:subPropertyOf :relation;
  :abstract true;
  :rangeIncludes :Entity .
:partOf a rdf:Property;
  :propagatesEncounter true;
  rdfs:comment "This entity is a component of the referenced entity.";
  rdfs:subPropertyOf :composition;
  :rangeIncludes :CreativeWork .
:emblem a rdf:Property;
  rdfs:comment "The image an entity presents itself by — an avatar, poster, cover, logo, or favicon. Representation, not content: swap it and the entity is the same. Where a :depiction is a photograph someone took of the thing, an emblem is the image the thing was given to stand for it, photographic or not; banners and headers are decoration rather than emblems. The single elected image among candidates; its bytes live on the :ImageObject.";
  rdfs:subPropertyOf :relation;
  owl:maxCardinality 1;
  :domainIncludes :Entity;
  :rangeIncludes :ImageObject .
:artist a rdf:Property;
  :propagatesEncounter true;
  rdfs:comment "The artist who created or performed the musical work.";
  rdfs:subPropertyOf :performer;
  :domainIncludes :MusicRecording,
    :MusicAlbum,
    :AudioObject;
  :rangeIncludes :MusicGroup .
:inAlbum a rdf:Property;
  :propagatesEncounter true;
  rdfs:comment "The album that contains this musical recording.";
  owl:maxCardinality 1;
  rdfs:subPropertyOf :partOf;
  :domainIncludes :MusicRecording;
  :rangeIncludes :MusicAlbum .
:duration a rdf:Property;
  rdfs:comment "The duration of the musical recording or media content.";
  owl:maxCardinality 1;
  :domainIncludes :MusicRecording,
    :PodcastEpisode,
    :AudioObject,
    :VideoObject;
  :rangeIncludes :Text .
:genre a rdf:Property;
  rdfs:comment "The genre of the creative work.";
  :domainIncludes :CreativeWork,
    :AudioObject;
  :rangeIncludes :Text .
:datePublished a rdf:Property;
  rdfs:comment "When the work was published or released, at whatever precision the source knows (a bare year is a year-precision date). A date on the work's own timeline: the moment its :PublishAction occurred.";
  owl:maxCardinality 1;
  owl:equivalentProperty schemaorg:datePublished;
  :domainIncludes :CreativeWork;
  :rangeIncludes :Date,
    :DateTime .
:target a rdf:Property;
  rdfs:comment "What an action is directed toward, as opposed to what it is carried out on (:object). A collection operation targets the collection it adds to or removes from; a movement verb targets where it ended up, with :object naming where it began (:NavigateAction from one page to the next, :TravelAction from one place to the next).";
  owl:maxCardinality 1;
  :domainIncludes :Action;
  :rangeIncludes :Entity .
# linkedin
:ExperienceAction a rdfs:Class;
  rdfs:comment "A segment of lived activity the subject engaged in or underwent — a manually-logged time block or life episode (its :result is the :Session it constitutes: a :Tenure, :Residence, :Relationship, and the like), or a punctual life event (:BirthAction, :DeathAction). Carries the real occurrence via :startTime/:endTime; the constituted session takes its span from the action.";
  rdfs:subClassOf :Action .
:JoinAction a rdfs:Class;
  rdfs:comment "The subject joined the :object organization or realm — the opening boundary of a membership. Its :result may carry the :Tenure, :Membership, or :Enrollment the membership constitutes.";
  rdfs:subClassOf :ExperienceAction .
:LeaveAction a rdfs:Class;
  rdfs:comment "The subject left the :object organization or realm — the closing boundary of a membership opened by a :JoinAction.";
  rdfs:subClassOf :ExperienceAction .
:Tenure a rdfs:Class;
  rdfs:comment "A stretch of employment — the :result of the :ExperienceAction whose span it takes. Dateless itself; carries the :employer (an :Organization) and the :role held. The subject's :memberOf run over the employer derives from this span.";
  rdfs:subClassOf :Session .
:Enrollment a rdfs:Class;
  rdfs:comment "A stretch of study at a school — the :result of the :ExperienceAction whose span it takes. Dateless itself; carries the :school (an :Organization) and the :degree pursued. The subject's :memberOf run over the school derives from this span.";
  rdfs:subClassOf :Session .
:Membership a rdfs:Class;
  rdfs:comment "A stretch of belonging to an organization or realm — the :result of the :ExperienceAction whose span it takes. Dateless itself; carries the :org and the :role held. The subject's :memberOf run derives from this span.";
  rdfs:subClassOf :Session .
:Relationship a rdfs:Class;
  rdfs:comment "A stretch of romantic partnership — the :result of the :ExperienceAction whose span it takes. Dateless itself; names the other person via :with. The subject's :partner run derives from this span.";
  rdfs:subClassOf :Session .
:role a rdf:Property;
  rdfs:comment "The role, title, or nature held during a :Tenure, :Membership, or :Relationship.";
  owl:maxCardinality 1;
  :domainIncludes :Tenure,
    :Membership,
    :Relationship;
  :rangeIncludes :Text .
:degree a rdf:Property;
  rdfs:comment "The degree or program pursued during an :Enrollment.";
  owl:maxCardinality 1;
  :domainIncludes :Enrollment;
  :rangeIncludes :Text .
:Intangible a rdfs:Class;
  rdfs:comment "An entity with no physical or creative existence of its own — a term, a selector, a category.";
  rdfs:subClassOf :Entity .
:DefinedTerm a rdfs:Class;
  rdfs:comment "A word or code from a vocabulary — a tag, a category — used to classify other entities.";
  rdfs:subClassOf :Intangible .
:WatchAction a rdfs:Class;
  rdfs:comment "The agent watched the :object — a video, a film, a show. Opens or extends the agent's :consuming run over it.";
  rdfs:subClassOf :ConsumeAction .
:width a rdf:Property;
  rdfs:comment "The width of the media content in pixels.";
  owl:maxCardinality 1;  :domainIncludes :ImageObject,
    :VideoObject;
  :rangeIncludes :Number .
:height a rdf:Property;
  rdfs:comment "The height of the media content in pixels.";
  owl:maxCardinality 1;  :domainIncludes :ImageObject,
    :VideoObject;
  :rangeIncludes :Number .

# youtube
:AnnotateAction a rdfs:Class;
  rdfs:comment "The agent wrote a note on something — a comment on a highlighted passage, a note on a work, a margin note on a page. Its :result is the :Comment, whose :about names what it annotates.";
  rdfs:subClassOf :CreateAction .

# timing-app
:DeviceSession a rdfs:Class;
  rdfs:comment "A screen-usage segment — an app-focus/app-usage block on a device. The :result of an :ExecuteAction (which carries the measured span); dateless itself, carrying the focused resource (:subject), the project (:isPartOf), and, when no resource is present, the window title (:name).";
  rdfs:subClassOf :Session .
:PhysicalObject a rdfs:Class;
  rdfs:comment "A tangible object the subject owns or uses and has a history with — a device, a vehicle, an instrument. Its kind is open-ended :category data ('computer', 'car'); its make and model is :model. Subclasses name functional roles an object plays in actions, such as :Device.";
  rdfs:subClassOf :Entity .
:Device a rdfs:Class;
  rdfs:comment "A physical computing device the subject runs software on — the :instrument of an :ExecuteAction, and the device a :DeviceSession takes place on. A functional role rather than a kind: whether it is a computer, phone, or tablet is :category data. It runs within a :Realm (via :inRealm), the logical machine that may outlive the hardware.";
  rdfs:subClassOf :PhysicalObject .
:Directory a rdfs:Class;
  rdfs:subClassOf :Collection;
  rdfs:comment "A filesystem directory: a :Collection whose members are the files (:MediaObject) and subdirectories (:Directory) it :contains, identified by its path (:handle) within the machine it lives on (:inRealm). It has no content of its own; its membership is its content." .
:workingDirectory a rdf:Property;
  rdfs:comment "The filesystem directory a session took place in — a terminal's current working directory or a folder open in a file manager. Where the session happened, not what it was about (cf. :subject).";
  owl:maxCardinality 1;
  :domainIncludes :Session;
  :rangeIncludes :Directory .
:subject a rdf:Property;
  rdfs:comment "The specific resource a session was spent on — the document, page, or media in focus. A specialization of :about (subject matter) for sessions.";
  rdfs:subPropertyOf :about;
  :domainIncludes :Session;
  :rangeIncludes :Entity .
:model a rdf:Property;
  rdfs:comment "The make/model of a physical object (e.g. 'Mac17,9', 'iPhone15,2') — the manufactured model, distinct from the object's own :name and from its :category kind.";
  owl:maxCardinality 1;
  :domainIncludes :PhysicalObject;
  :rangeIncludes :Text .

# foursquare
:CheckInAction a rdfs:Class;
  rdfs:comment "The agent announced their presence at the :object, a :Venue, at :timestamp.";
  rdfs:subClassOf :CommunicateAction .

# goodreads
:Book a rdfs:Class;
  rdfs:comment "A book, as an edition: carries its :author and :pageCount.";
  rdfs:subClassOf :CreativeWork .
:pageCount a rdf:Property;
  rdfs:comment "The number of pages in a document or book (an edition-level count).";
  owl:maxCardinality 1;
  :domainIncludes :DocumentObject,
    :Book;
  :rangeIncludes :Number .
:publisher a rdf:Property;
  rdfs:comment "The publisher of the creative work.";
  rdfs:subPropertyOf :creator;
  :domainIncludes :CreativeWork;
  :rangeIncludes :Organization .
:creator a rdf:Property;
  :propagatesEncounter true;
  rdfs:comment "An agent who brought the work into existence (authored, produced, or released it).";
  rdfs:subPropertyOf :attribution;
  :domainIncludes :CreativeWork;
  :rangeIncludes :Agent .

# marvin
:ReadAction a rdfs:Class;
  rdfs:comment "The agent read the :object — a book, an article, a document. Opens or extends the agent's :consuming run over it.";
  rdfs:subClassOf :ConsumeAction .
:QuoteAction a rdfs:Class;
  rdfs:comment "The agent selected a passage of the :object — a highlight in a book or document, an excerpt from a page. Its :result is the :Quotation carrying the text and its position via :selector.";
  rdfs:subClassOf :CreateAction .
:Quotation a rdfs:Class;
  rdfs:comment "A passage selected from a work — a highlight, an excerpt. Carries the text as :body, its position in the work via :selector, and, for a visual annotation, its :annotationStyle and :color. The :result of a :QuoteAction.";
  rdfs:subClassOf :CreativeWork .

# zotero
:Category a rdfs:Class;
  rdfs:comment "A classification drawn from a fixed set of kinds, as distinct from a free-form :Tag.";
  rdfs:subClassOf :DefinedTerm .
:Selector a rdfs:Class;
  rdfs:comment "A position within a resource — where a passage sits in a book, a page, or a media file. Carries a machine value (:selectorValue), a readable label (:selectorLabel), and a normalized position (:selectorProgress); the subclasses name the addressing scheme.";
  rdfs:subClassOf :Intangible .
:PageSelector a rdfs:Class;
  rdfs:comment "A position in a paginated document, addressed by page number.";
  rdfs:subClassOf :Selector .
:EpubCfiSelector a rdfs:Class;
  rdfs:comment "A position in an EPUB, addressed by a Canonical Fragment Identifier.";
  rdfs:subClassOf :Selector .
:Article a rdfs:Class;
  rdfs:comment "A written piece published on the web or in a periodical — a news story, a blog post, a feed item.";
  rdfs:subClassOf :CreativeWork .
:snapshotOf a rdf:Property;
  rdfs:comment "The resource this media is a capture of: a screenshot or archive (the :result of a :ScreenshotAction or :ArchiveAction) points at the :Entity whose URL it captured at a moment. The referent is the addressed resource itself, the URL entity. Screenshot and archive are told apart by the media's type; being a snapshot is the role this edge confers.";
  rdfs:subPropertyOf :relation;
  :domainIncludes :MediaObject;
  :rangeIncludes :Entity .
:color a rdf:Property;
  rdfs:comment "Color associated with the entity (hex or name).";
  owl:maxCardinality 1;
  :domainIncludes :Quotation,
    :Tag,
    :Category;
  :rangeIncludes :Text .
:annotationStyle a rdf:Property;
  rdfs:comment "Type of visual annotation (highlight, underline, strikethrough, squiggly, box, margin).";
  owl:maxCardinality 1;
  :domainIncludes :Quotation;
  :rangeIncludes :Text .
:selector a rdf:Property;
  rdfs:comment "Selectors identifying content position within a resource.";
  :domainIncludes :Quotation;
  :rangeIncludes :Selector .
:selectorValue a rdf:Property;
  rdfs:comment "The selector value string (EPUB CFI, media fragment, page number, etc.).";
  owl:maxCardinality 1;
  :domainIncludes :Selector;
  :rangeIncludes :Text .
:selectorLabel a rdf:Property;
  rdfs:comment "Human-readable location label such as pt3ch1p40, p215, or 23:43.";
  owl:maxCardinality 1;
  :domainIncludes :Selector;
  :rangeIncludes :Text .
