// Serves the schema documentation site at schema.chronicle.app from Cloudflare
// Workers static assets. Build it first with `npm run docs:build:deploy`.
{
  "name": "chronicle-schema",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./build/deploy",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "schema.chronicle.app", "custom_domain": true }],
}
