:MediaObject skos:example example:message-with-photo, example:group-message-attachments .
:ImageObject skos:example example:message-with-photo .
:AudioObject skos:example example:voice-message .
:VideoObject skos:example example:group-message-attachments .
:DocumentObject skos:example example:group-message-attachments .

:source skos:example example:entity-with-url, example:task-completed .
:sourceId skos:example example:entity-with-url, example:message-with-photo .
:name skos:example example:entity-with-url .
:url skos:example example:entity-with-url .
:description skos:example example:task-edited .
:handle skos:example example:shell-command, example:message-with-photo .
:sameAs skos:example example:message-with-photo, example:assistant-prompt .
