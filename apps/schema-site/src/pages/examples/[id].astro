---
import Paragraphs from '../../components/Paragraphs.astro';
import Payload from '../../components/Payload.astro';
import TermLink from '../../components/TermLink.astro';
import Layout from '../../layouts/Layout.astro';
import { examples, paths, url } from '../../lib/site.js';

export function getStaticPaths() {
  return examples.map(example => ({ params: { id: example.id }, props: { example } }));
}
const { example } = Astro.props;
---

<Layout path={paths.example(example.id)} kind="example" title={example.title} description={example.body}>
  <header class="page-header">
    <p class="eyebrow"><a href={url('examples/index.html')}>Examples</a></p>
    <h1>{example.title}</h1>
  </header>
  <div class="prose"><Paragraphs text={example.body} /></div>
  <Payload example={example} />
  {
    example.usedBy.length > 0 && (
      <section>
        <h2>Terms in this example</h2>
        <p class="chips">{example.usedBy.map(name => <TermLink name={name} />)}</p>
      </section>
    )
  }
</Layout>
