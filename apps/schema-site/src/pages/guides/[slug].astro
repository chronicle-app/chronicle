---
import Card from '../../components/Card.astro';
import Layout from '../../layouts/Layout.astro';
import { guides, href, paths, url } from '../../lib/site.js';

export function getStaticPaths() {
  return guides.map((guide, index) => ({
    params: { slug: guide.slug },
    props: { guide, previous: guides[index - 1], next: guides[index + 1] },
  }));
}
const { guide, previous, next } = Astro.props;
---

<Layout path={paths.guide(guide.slug)} kind="guide" title={guide.title} description={guide.lead} toc={guide.headings}>
  <header class="page-header">
    <p class="eyebrow">Guide {guide.number} of {guides.length}</p>
    <h1>{guide.title}</h1>
  </header>
  {/* Rendered from Markdown by the guide loader, which escapes text and checks links. */}
  <article class="prose" set:html={guide.html} />
  <nav class="pager" aria-label="Guides">
    {previous ? <Card href={href.guide(previous.slug)} kicker="Previous" title={previous.title} /> : <span />}
    {
      next ? (
        <Card class="next" href={href.guide(next.slug)} kicker="Next" title={next.title} />
      ) : (
        <Card class="next" href={url('examples/index.html')} kicker="Next" title="Examples" />
      )
    }
  </nav>
</Layout>
