{
  "name": "@chronicle.app/schema-site",
  "version": "0.1.0",
  "private": true,
  "description": "The Chronicle schema documentation site, schema.chronicle.app",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "build:deploy": "node scripts/deploy.js",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "test": "node --test scripts/*.test.js",
    "lint": "eslint src scripts public/assets astro.config.mjs --ext .js,.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "astro": "^7.3.5",
    "markdown-it": "^14.3.2",
    "n3": "^1.23.1"
  },
  "author": "Andrew Louis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chronicle-app/chronicle.git",
    "directory": "apps/schema-site"
  }
}
