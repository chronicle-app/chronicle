{
  "name": "@chronicle.app/cli",
  "description": "Extract your digital history into a shared vocabulary.",
  "version": "0.3.0",
  "author": "Andrew Louis",
  "bin": {
    "chronicle": "./bin/run.js"
  },
  "bugs": {
    "url": "https://github.com/chronicle-app/chronicle/issues/new?labels=cli&title=[cli]%20"
  },
  "dependencies": {
    "@chronicle.app/auth": "0.3.0",
    "@chronicle.app/claude-code": "0.3.0",
    "@chronicle.app/etl": "0.3.0",
    "@chronicle.app/etl-sqlite": "0.3.0",
    "@chronicle.app/imessage": "0.3.0",
    "@chronicle.app/logging": "0.3.0",
    "@chronicle.app/safari": "0.3.0",
    "@chronicle.app/schema": "0.3.0",
    "@chronicle.app/shell": "0.3.0",
    "@chronicle.app/things-todo": "0.3.0",
    "@inkjs/ui": "^2.0.0",
    "@oclif/core": "^4.2",
    "@oclif/plugin-autocomplete": "^3.2.11",
    "@oclif/plugin-commands": "^4.1.11",
    "@oclif/plugin-help": "^6",
    "@oclif/plugin-warn-if-update-available": "^4.0.0",
    "chalk": "^4.1.2",
    "glob": "^13.0.6",
    "ink": "^5.0.1",
    "open": "^10.1.0",
    "react": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@chronicle.app/tsconfig": "0.3.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.17",
    "oclif": "^4",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "bin/run.js",
    "bin/run.cmd",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "catalog.json",
    "oclif.manifest.json"
  ],
  "homepage": "https://chronicle.app",
  "keywords": [
    "oclif"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "oclif": {
    "bin": "chronicle",
    "dirname": "chronicle",
    "commands": "./dist/commands",
    "helpClass": "./dist/help/Help.js",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-commands",
      "@oclif/plugin-autocomplete",
      "@oclif/plugin-warn-if-update-available"
    ],
    "topicSeparator": " ",
    "topics": {
      "extract": {
        "description": "Extract records from a source as Chronicle JSON-LD"
      },
      "sources": {
        "description": "List the sources and the record types each has"
      },
      "auth": {
        "description": "Sign in to providers and manage stored credentials"
      },
      "config": {
        "description": "Set flag defaults and save presets"
      },
      "config:preset": {
        "description": "Save sets of flags to use with `--preset`"
      },
      "plugins": {
        "description": "List, install, and remove source plugins"
      }
    },
    "pjson": {
      "packageManager": "npm"
    },
    "warn-if-update-available": {
      "timeoutInDays": 7,
      "frequency": 1,
      "frequencyUnit": "days",
      "message": "<%= config.name %> <%= chalk.greenBright(latest) %> is available (you have <%= config.version %>). Update with: <%= config.root.includes(\"_npx\") ? \"npx @chronicle.app/cli@latest\" : \"npm install -g @chronicle.app/cli\" %>"
    },
    "hooks": {
      "command_not_found": "./dist/hooks/commandNotFound.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chronicle-app/chronicle.git",
    "directory": "apps/cli"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -b tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts,.tsx,.js",
    "test": "node --test test/*.test.js",
    "prepack": "oclif manifest 1>&2 && node scripts/pack-catalog.js",
    "postpack": "node -e \"for (const f of ['oclif.manifest.json', 'catalog.json']) require('node:fs').rmSync(f, { force: true })\"",
    "gallery": "tsc -b tsconfig.lib.json && node dist/output/gallery.js"
  }
}
