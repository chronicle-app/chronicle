{
  "name": "@chronicle.app/imessage",
  "version": "0.4.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts,.js",
    "test": "node --test src/*.test.js"
  },
  "keywords": [],
  "author": "Andrew Louis",
  "license": "MIT",
  "type": "module",
  "description": "Chronicle imessage extraction plugin",
  "devDependencies": {
    "@chronicle.app/etl": "0.4.0",
    "@chronicle.app/schema": "0.4.0",
    "@chronicle.app/tsconfig": "0.4.0",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "homepage": "https://chronicle.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/chronicle-app/chronicle.git",
    "directory": "plugins/imessage"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@chronicle.app/etl-sqlite": "0.4.0",
    "@chronicle.app/apple": "0.4.0",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@chronicle.app/etl": ">=0.1.0 <1.0.0",
    "@chronicle.app/schema": ">=0.1.0 <1.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "chronicle": {
    "plugin": true,
    "sources": {
      "imessage": {
        "strategies": {
          "app-db": {
            "delivery": "local",
            "recordTypes": [
              "messages"
            ],
            "default": true,
            "locations": [
              {
                "path": "~/Library/Messages/chat.db"
              }
            ],
            "databases": [
              {
                "tables": {
                  "message": [
                    "ROWID",
                    "guid",
                    "text",
                    "service",
                    "date",
                    "is_from_me",
                    "handle_id",
                    "attributedBody",
                    "item_type?"
                  ],
                  "handle": [
                    "ROWID",
                    "id",
                    "service"
                  ],
                  "chat": [
                    "ROWID",
                    "style",
                    "display_name?",
                    "group_id?",
                    "original_group_id?"
                  ],
                  "chat_message_join": [
                    "chat_id",
                    "message_id"
                  ],
                  "chat_handle_join": [
                    "chat_id",
                    "handle_id"
                  ],
                  "message_attachment_join": [
                    "message_id",
                    "attachment_id"
                  ],
                  "attachment": [
                    "ROWID",
                    "guid",
                    "filename",
                    "mime_type",
                    "uti",
                    "total_bytes",
                    "transfer_name",
                    "is_outgoing"
                  ]
                }
              }
            ]
          }
        },
        "platforms": [
          "darwin"
        ],
        "requires": [
          "full-disk-access"
        ]
      }
    },
    "deepLinks": {
      "imessage": {
        "Message": "messages://open?message-guid={sourceId}"
      }
    }
  }
}
