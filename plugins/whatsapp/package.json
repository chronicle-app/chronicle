{
  "name": "@chronicle.app/whatsapp",
  "version": "0.4.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts,.js",
    "test": "node --test src/*.test.js"
  },
  "keywords": [
    "chronicle",
    "whatsapp",
    "messages"
  ],
  "author": "Andrew Louis",
  "license": "MIT",
  "type": "module",
  "description": "Chronicle plugin for extracting message history from the local WhatsApp database (macOS ChatStorage.sqlite)",
  "devDependencies": {
    "@chronicle.app/etl": "0.4.0",
    "@chronicle.app/schema": "0.4.0",
    "@chronicle.app/tsconfig": "0.4.0",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "homepage": "https://chronicle.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/chronicle-app/chronicle.git",
    "directory": "plugins/whatsapp"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@chronicle.app/etl-sqlite": "0.4.0",
    "@chronicle.app/apple": "0.4.0",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@chronicle.app/etl": ">=0.1.0 <1.0.0",
    "@chronicle.app/schema": ">=0.1.0 <1.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "chronicle": {
    "plugin": true,
    "sources": {
      "whatsapp": {
        "strategies": {
          "backup": {
            "delivery": "export",
            "recordTypes": [
              "messages"
            ]
          },
          "app-db": {
            "delivery": "local",
            "recordTypes": [
              "messages"
            ],
            "default": true,
            "locations": [
              {
                "path": "~/Library/Group Containers/group.net.whatsapp.WhatsApp.shared/ChatStorage.sqlite"
              }
            ],
            "databases": [
              {
                "tables": {
                  "ZWAMESSAGE": [
                    "Z_PK",
                    "ZSTANZAID",
                    "ZTEXT",
                    "ZMESSAGEDATE",
                    "ZISFROMME",
                    "ZMESSAGETYPE",
                    "ZFROMJID",
                    "ZCHATSESSION",
                    "ZGROUPMEMBER",
                    "ZPARENTMESSAGE",
                    "ZMEDIAITEM"
                  ],
                  "ZWACHATSESSION": [
                    "Z_PK",
                    "ZCONTACTJID",
                    "ZSESSIONTYPE",
                    "ZPARTNERNAME"
                  ],
                  "ZWAMEDIAITEM": [
                    "ZMESSAGE",
                    "ZMEDIALOCALPATH",
                    "ZTITLE",
                    "ZMETADATA"
                  ],
                  "ZWAGROUPMEMBER": [
                    "Z_PK",
                    "ZMEMBERJID",
                    "ZCONTACTNAME",
                    "ZCHATSESSION"
                  ],
                  "ZWAPROFILEPUSHNAME": [
                    "ZJID",
                    "ZPUSHNAME"
                  ]
                }
              }
            ]
          }
        },
        "platforms": [
          "darwin"
        ],
        "requires": [
          "full-disk-access"
        ]
      }
    }
  }
}
