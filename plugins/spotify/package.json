{
  "name": "@chronicle.app/spotify",
  "version": "0.6.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts,.js",
    "test": "node --test src/*.test.js",
    "shapes": "node src/shapes.test.js --update"
  },
  "keywords": [
    "chronicle",
    "spotify"
  ],
  "author": "Andrew Louis",
  "license": "MIT",
  "type": "module",
  "description": "Chronicle plugin for extracting data from Spotify",
  "devDependencies": {
    "@chronicle.app/etl": "0.6.0",
    "@chronicle.app/schema": "0.6.0",
    "@chronicle.app/tsconfig": "0.6.0",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "homepage": "https://chronicle.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/chronicle-app/chronicle.git",
    "directory": "plugins/spotify"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@chronicle.app/auth": "0.6.0",
    "axios": "^1.7.9",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@chronicle.app/etl": ">=0.1.0 <1.0.0",
    "@chronicle.app/schema": ">=0.1.0 <1.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "chronicle": {
    "plugin": true,
    "sources": {
      "spotify": {
        "strategies": {
          "api": {
            "delivery": "api",
            "recordTypes": [
              "playlist-tracks",
              "listens",
              "saved-albums",
              "saved-tracks"
            ],
            "default": true
          },
          "archive": {
            "delivery": "export",
            "layouts": [
              {
                "name": "Extended streaming history",
                "files": [
                  "Streaming_History_Audio_*.json"
                ],
                "match": [
                  {
                    "path": "Streaming_History_Audio_*.json",
                    "head": "^\\s*\\[\\s*\\{\\s*\"ts\"\\s*:"
                  }
                ]
              },
              {
                "name": "Extended streaming history, endsong files",
                "files": [
                  "endsong_*.json"
                ],
                "match": [
                  {
                    "path": "endsong_*.json",
                    "head": "^\\s*\\[\\s*\\{\\s*\"ts\"\\s*:"
                  }
                ]
              },
              {
                "name": "Account data",
                "files": [
                  "Userdata.json",
                  "YourLibrary.json"
                ]
              }
            ],
            "recordTypes": [
              "listens",
              "saved-tracks",
              "saved-albums",
              "saved-episodes",
              "follows",
              "playlist-tracks",
              "searches"
            ],
            "default": true
          }
        }
      }
    }
  }
}
