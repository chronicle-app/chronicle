{
  "name": "@chronicle.app/google-calendar",
  "version": "0.4.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts,.js",
    "test": "node --test src/*.test.js",
    "shapes": "node src/shapes.test.js --update"
  },
  "keywords": [
    "chronicle",
    "google",
    "calendar"
  ],
  "author": "Andrew Louis",
  "license": "MIT",
  "type": "module",
  "description": "Chronicle plugin for the events on your Google calendars",
  "dependencies": {
    "@chronicle.app/google": "0.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@chronicle.app/etl": "0.4.0",
    "@chronicle.app/schema": "0.4.0",
    "@chronicle.app/tsconfig": "0.4.0",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "homepage": "https://chronicle.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/chronicle-app/chronicle.git",
    "directory": "plugins/google-calendar"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@chronicle.app/etl": ">=0.1.0 <1.0.0",
    "@chronicle.app/schema": ">=0.1.0 <1.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "chronicle": {
    "plugin": true,
    "sources": {
      "google-calendar": {
        "strategies": {
          "api": {
            "delivery": "api",
            "recordTypes": [
              "events"
            ],
            "default": true
          }
        }
      }
    },
    "deepLinks": {
      "google-calendar": {
        "Event": "https://www.google.com/calendar/event?eid={sourceId}"
      }
    }
  }
}
