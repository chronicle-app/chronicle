{
  "name": "@chronicle.app/apple-wallet",
  "version": "0.6.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts,.js",
    "test": "node --test src/*.test.js",
    "shapes": "node src/shapes.test.js --update"
  },
  "keywords": [
    "chronicle",
    "apple-wallet",
    "apple-pay",
    "transactions"
  ],
  "author": "Andrew Louis",
  "license": "MIT",
  "type": "module",
  "description": "Chronicle plugin for the card transactions in Apple Wallet on a Mac",
  "devDependencies": {
    "@chronicle.app/etl": "0.6.0",
    "@chronicle.app/schema": "0.6.0",
    "@chronicle.app/tsconfig": "0.6.0",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "homepage": "https://chronicle.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/chronicle-app/chronicle.git",
    "directory": "plugins/apple-wallet"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@chronicle.app/etl-sqlite": "0.6.0",
    "@chronicle.app/apple": "0.6.0",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@chronicle.app/etl": ">=0.1.0 <1.0.0",
    "@chronicle.app/schema": ">=0.1.0 <1.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "chronicle": {
    "plugin": true,
    "sources": {
      "apple-wallet": {
        "strategies": {
          "app-db": {
            "delivery": "local",
            "recordTypes": [
              "transactions"
            ],
            "default": true,
            "locations": [
              {
                "path": "~/Library/Passes/passes23.sqlite"
              }
            ],
            "databases": [
              {
                "tables": {
                  "payment_transaction": [
                    "pid",
                    "identifier",
                    "service_identifier",
                    "transaction_date",
                    "amount",
                    "currency_code",
                    "merchant_name",
                    "merchant_raw_name",
                    "merchant_industry_code",
                    "merchant_industry_category",
                    "locality",
                    "administrative_area",
                    "location_latitude",
                    "location_longitude",
                    "transaction_status",
                    "transaction_type",
                    "adjustment_type",
                    "source_pid"
                  ],
                  "pass": [
                    "pid",
                    "unique_id",
                    "primary_account_identifier",
                    "e?",
                    "primary_account_suffix",
                    "organization_name",
                    "supports_fpan_notifications",
                    "transaction_source_pid"
                  ],
                  "payment_application": [
                    "transaction_source_pid",
                    "pass_pid"
                  ]
                }
              }
            ]
          }
        },
        "platforms": [
          "darwin"
        ]
      }
    }
  }
}
