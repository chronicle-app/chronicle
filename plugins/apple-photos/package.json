{
  "name": "@chronicle.app/apple-photos",
  "version": "0.6.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts,.js",
    "test": "node --test src/*.test.js",
    "shapes": "node src/shapes.test.js --update"
  },
  "keywords": [
    "chronicle",
    "apple-photos",
    "photos"
  ],
  "author": "Andrew Louis",
  "license": "MIT",
  "type": "module",
  "description": "Chronicle plugin for your Photos library: what each photo and video is, who is in it, what you did with it, and what was shared with you in Messages",
  "devDependencies": {
    "@chronicle.app/etl": "0.6.0",
    "@chronicle.app/schema": "0.6.0",
    "@chronicle.app/tsconfig": "0.6.0",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "homepage": "https://chronicle.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/chronicle-app/chronicle.git",
    "directory": "plugins/apple-photos"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@chronicle.app/etl-sqlite": "0.6.0",
    "@chronicle.app/apple": "0.6.0",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@chronicle.app/etl": ">=0.1.0 <1.0.0",
    "@chronicle.app/schema": ">=0.1.0 <1.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "chronicle": {
    "plugin": true,
    "sources": {
      "apple-photos": {
        "strategies": {
          "app-db": {
            "delivery": "local",
            "recordTypes": [
              "photos",
              "activity",
              "favorites",
              "shared-with-you"
            ],
            "default": true,
            "locations": [
              {
                "path": "~/Pictures/Photos Library.photoslibrary/database/Photos.sqlite"
              }
            ],
            "databases": [
              {
                "tables": {
                  "Z_PRIMARYKEY": [
                    "Z_NAME",
                    "Z_ENT"
                  ],
                  "ZASSET": [
                    "Z_PK",
                    "ZUUID",
                    "ZKIND",
                    "ZDATECREATED",
                    "ZWIDTH",
                    "ZHEIGHT",
                    "ZDURATION",
                    "ZLATITUDE",
                    "ZLONGITUDE",
                    "ZFAVORITE",
                    "ZCLOUDASSETGUID?",
                    "ZKINDSUBTYPE?",
                    "ZDEPTHTYPE?",
                    "ZAVALANCHEUUID?",
                    "ZADDEDDATE?",
                    "ZUNIFORMTYPEIDENTIFIER?",
                    "ZVIDEOCPDURATIONVALUE?",
                    "ZLASTSHAREDDATE?",
                    "ZADJUSTMENTTIMESTAMP?",
                    "ZADJUSTMENTSSTATE?",
                    "ZBUNDLESCOPE?",
                    "ZTRASHEDSTATE?",
                    "ZVISIBILITYSTATE?",
                    "ZHIDDEN?",
                    "ZACTIVELIBRARYSCOPEPARTICIPATIONSTATE?"
                  ],
                  "ZADDITIONALASSETATTRIBUTES": [
                    "Z_PK",
                    "ZASSET",
                    "ZVIDEOCPDURATIONTIMESCALE?",
                    "ZTITLE?",
                    "ZORIGINALFILENAME?",
                    "ZIMPORTEDBYBUNDLEIDENTIFIER?",
                    "ZIMPORTEDBYDISPLAYNAME?",
                    "ZLASTVIEWEDDATE?",
                    "ZSYNDICATIONIDENTIFIER?"
                  ],
                  "ZASSETDESCRIPTION": [
                    "Z_PK",
                    "ZASSETATTRIBUTES",
                    "ZLONGDESCRIPTION?"
                  ],
                  "ZEXTENDEDATTRIBUTES": [
                    "ZASSET",
                    "ZCAMERAMAKE?",
                    "ZCAMERAMODEL?",
                    "ZLENSMODEL?",
                    "ZFOCALLENGTH?",
                    "ZFOCALLENGTHIN35MM?",
                    "ZAPERTURE?",
                    "ZSHUTTERSPEED?",
                    "ZISO?",
                    "ZEXPOSUREBIAS?",
                    "ZMETERINGMODE?",
                    "ZWHITEBALANCE?",
                    "ZFLASHFIRED?",
                    "ZDIGITALZOOMRATIO?",
                    "ZORIENTATION?"
                  ],
                  "ZGENERICALBUM": [
                    "Z_PK",
                    "ZKIND",
                    "ZTITLE",
                    "ZUUID",
                    "ZPARENTFOLDER",
                    "ZTRASHEDSTATE",
                    "ZCLOUDGUID?"
                  ],
                  "ZPERSON": [
                    "Z_PK",
                    "ZPERSONUUID",
                    "ZFULLNAME",
                    "ZDETECTIONTYPE",
                    "ZMERGETARGETPERSON"
                  ],
                  "ZDETECTEDFACE": [
                    "ZASSETFORFACE",
                    "ZPERSONFORFACE",
                    "ZNAMESOURCE?",
                    "ZMANUAL?"
                  ]
                }
              }
            ]
          }
        },
        "platforms": [
          "darwin"
        ],
        "requires": [
          "full-disk-access"
        ]
      }
    },
    "deepLinks": {
      "apple-photos": {
        "StillImage": "photos://asset?identifier={sourceId}&cloud-identifier={sourceId}:001",
        "MovingImage": "photos://asset?identifier={sourceId}&cloud-identifier={sourceId}:001"
      }
    }
  }
}
