{
  "name": "@chronicle.app/apple-podcasts",
  "version": "0.4.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts,.js",
    "test": "node --test src/*.test.js",
    "shapes": "node src/shapes.test.js --update"
  },
  "keywords": [
    "chronicle",
    "apple-podcasts"
  ],
  "author": "Andrew Louis",
  "license": "MIT",
  "type": "module",
  "description": "Chronicle plugin for Apple Podcasts listening history",
  "devDependencies": {
    "@chronicle.app/etl": "0.4.0",
    "@chronicle.app/schema": "0.4.0",
    "@chronicle.app/tsconfig": "0.4.0",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  },
  "homepage": "https://chronicle.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/chronicle-app/chronicle.git",
    "directory": "plugins/apple-podcasts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@chronicle.app/etl-sqlite": "0.4.0",
    "@chronicle.app/apple": "0.4.0",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "@chronicle.app/etl": ">=0.1.0 <1.0.0",
    "@chronicle.app/schema": ">=0.1.0 <1.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "chronicle": {
    "plugin": true,
    "sources": {
      "apple-podcasts": {
        "strategies": {
          "app-db": {
            "delivery": "local",
            "recordTypes": [
              "listens",
              "subscriptions"
            ],
            "default": true,
            "locations": [
              {
                "path": "~/Library/Group Containers/243LU875E5.groups.com.apple.podcasts/Documents/MTLibrary.sqlite"
              }
            ],
            "databases": [
              {
                "tables": {
                  "ZMTEPISODE": [
                    "ZGUID",
                    "ZTITLE",
                    "ZAUTHOR",
                    "ZPLAYHEAD",
                    "ZPLAYCOUNT",
                    "ZPLAYSTATELASTMODIFIEDDATE",
                    "ZLASTDATEPLAYED",
                    "ZLASTUSERMARKEDASPLAYEDDATE",
                    "ZISBOOKMARKED",
                    "ZLASTBOOKMARKEDDATE",
                    "ZPUBDATE",
                    "ZSTORETRACKID",
                    "ZWEBPAGEURL",
                    "ZARTWORKTEMPLATEURL",
                    "ZPODCASTUUID",
                    "ZCURRENTMEDIAENCLOSURE",
                    "ZDESCRIPTIONOBJECT",
                    "ZMETADATAIDENTIFIER"
                  ],
                  "ZMTPODCAST": [
                    "ZUUID",
                    "ZTITLE",
                    "ZAUTHOR",
                    "ZCATEGORY",
                    "ZFEEDURL",
                    "ZUPDATEDFEEDURL",
                    "ZIMAGEURL",
                    "ZSTORECOLLECTIONID",
                    "ZWEBPAGEURL",
                    "ZITEMDESCRIPTION",
                    "ZCHANNEL",
                    "ZSUBSCRIBED",
                    "ZADDEDDATE"
                  ],
                  "ZMTCHANNEL": [
                    "Z_PK",
                    "ZSTOREID",
                    "ZNAME"
                  ],
                  "ZMTMEDIAENCLOSURE": [
                    "Z_PK",
                    "ZDURATION",
                    "ZREMOTEURL",
                    "ZTRANSCRIPTIDENTIFIER"
                  ],
                  "ZMTEPISODEDESCRIPTION": [
                    "Z_PK",
                    "ZTEXT"
                  ],
                  "ZMTUPPMETADATA": [
                    "ZMETADATAIDENTIFIER",
                    "ZTIMESTAMP"
                  ]
                }
              }
            ]
          }
        },
        "platforms": [
          "darwin"
        ],
        "requires": [
          "full-disk-access"
        ]
      }
    }
  }
}
