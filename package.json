{
  "name": "chronicle",
  "version": "0.1.0",
  "private": true,
  "description": "Extract your digital history into a shared vocabulary.",
  "type": "module",
  "author": "Andrew Louis",
  "license": "MIT",
  "homepage": "https://chronicle.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/chronicle-app/chronicle.git"
  },
  "bugs": {
    "url": "https://github.com/chronicle-app/chronicle/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "core/*",
    "packages/*",
    "apps/*",
    "plugins/*",
    "tools/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint scripts .eslintrc.cjs prettier.config.cjs && npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test scripts/*.test.js && npm run test --workspaces --if-present",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "quality": "npm run versions:check && npm run schema:check && npm run build && npm run lint && npm run typecheck && npm run test && npm run format:check",
    "packages:check": "node scripts/check-packages.js",
    "schema:generate": "npm run generate -w @chronicle.app/schema",
    "schema:check": "npm run generate:check -w @chronicle.app/schema",
    "schema:docs": "npm run docs:dev -w @chronicle.app/schema",
    "schema:docs:build": "npm run docs:build -w @chronicle.app/schema",
    "release:version": "changeset version && node scripts/version-packages.js --sync",
    "versions:check": "node scripts/version-packages.js --check",
    "prepare": "husky",
    "release": "npm run quality && npm run packages:check && changeset publish --no-git-tag && node scripts/tag-release.js"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@chronicle.app/eslint-config": "0.1.0",
    "@chronicle.app/prettier-config": "0.1.0",
    "@chronicle.app/tsconfig": "0.1.0",
    "@types/node": "^22.10.1",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.6.2",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
