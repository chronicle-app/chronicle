{
  "name": "chronicle",
  "version": "0.0.0",
  "private": true,
  "description": "Extract your digital history into a shared vocabulary.",
  "type": "module",
  "author": "Andrew Louis",
  "license": "MIT",
  "homepage": "https://chronicle.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/chronicle-app/chronicle.git"
  },
  "bugs": {
    "url": "https://github.com/chronicle-app/chronicle/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "core/*",
    "packages/*",
    "apps/*",
    "plugins/*",
    "tools/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint scripts .eslintrc.cjs prettier.config.cjs && npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "quality": "npm run build && npm run lint && npm run typecheck && npm run test && npm run format:check",
    "packages:check": "node scripts/check-packages.js"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "prettier": "^3.6.2",
    "typescript": "^5.7.2",
    "@chronicle.app/tsconfig": "0.1.0",
    "@chronicle.app/eslint-config": "0.1.0",
    "@chronicle.app/prettier-config": "0.1.0",
    "@types/node": "^22.10.1"
  }
}
